<!-- Project Section -->
<section id="project" class="section">
    <div class="wrap">
        <p class="eyebrow">Projects</p>
        @* <h2>Selected Projects</h2> *@

        <div class="project-slider">

            <div class="project-slides">
                @for (int i = 0; i < SiteData.Projects.Length; i++)
                {
                    var p = SiteData.Projects[i];

                    <article class="card project-slide @(i == 0 ? "active" : "")">

                        <p class="kind">@p.Kind</p>

                        <h3>@p.Name</h3>

                        <p class="muted">@p.Summary</p>

                        <ul class="points">
                            @foreach (var h in p.Highlights)
                            {
                                <li>@h</li>
                            }
                        </ul>

                        <p class="stack">
                            @string.Join(" / ", p.Stack)
                        </p>

                    </article>
                }
            </div>

            <!-- Slider Controls -->
            <div class="project-controls">

                <button type="button" id="prevProject"
                        class="slider-btn"
                        aria-label="Previous project">
                    &#8592;
                </button>

                <span id="projectCounter">1 / @SiteData.Projects.Length</span>

                <button type="button" id="nextProject"
                        class="slider-btn"
                        aria-label="Next project">
                    &#8594;
                </button>

            </div>

        </div>
    </div>
</section>

<!--Services Section-->
<section id="services" class="section">
    <div class="wrap">
        <p class="eyebrow">Services</p>
        <h2>What I can build for you</h2>
        <div class="grid-2">
            @foreach (var s in SiteData.Services)
            {
                <article class="card">
                    <h3>@s.Title</h3>
                    <p class="muted">@s.Summary</p>
                    <ul class="chips">
                        @foreach (var o in s.Offers)
                        {
                            <li>@o</li>
                        }
                    </ul>
                </article>
            }
        </div>
    </div>
</section>


<!--Contact Section-->
<section id="contact" class="section">
    <div class="wrap grid-2">
        <div>
            <p class="eyebrow">Contact</p>
            <h2>Let's talk about your project</h2>
            <p class="muted">Tell me what you need built, fixed or tested. I will reply with questions and a rough plan.</p>
            <ul class="contact-list">
                <li><a href="mailto:@SiteData.Email">@SiteData.Email</a></li>
                <li><a href="tel:@(SiteData.Phone.Replace("-", ""))">@SiteData.Phone</a></li>
                <li><a href="@SiteData.LinkedIn" target="_blank" rel="noopener">LinkedIn profile</a></li>
                <li>@SiteData.Location</li>
            </ul>
        </div>
        <form method="post" asp-page="Index" asp-fragment="contact" class="card form" novalidate>
            @if (Model.Status is not null)
            {
                <p class="notice" role="status">@Model.Status</p>
            }
            <label for="Input_Name">Name</label>
            <input asp-for="Input.Name" autocomplete="name" />
            <span asp-validation-for="Input.Name" class="err"></span>

            <label for="Input_Email">Email</label>
            <input asp-for="Input.Email" type="email" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="err"></span>

            @* <label for="Input.contact">Whatsapp number</label> *@
            <label>Whatsapp number</label>
            <input asp-for="Input.contact" type="tel"  inputmode="tel" placeholder="+1234567890" autocomplete="tel"/>
            <span asp-validation-for="Input.contact" class="err"></span>

            <label for="Input_Message">Project details</label>
            <textarea asp-for="Input.Message" rows="5"></textarea>
            <span asp-validation-for="Input.Message" class="err"></span>

            <button class="pill pill-orange" type="submit">Send message</button>
        </form>
    </div>
</section>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const slides = document.querySelectorAll(".project-slide");
        const prevBtn = document.getElementById("prevProject");
        const nextBtn = document.getElementById("nextProject");
        const counter = document.getElementById("projectCounter");

        if (!slides.length || !prevBtn || !nextBtn) return;

        let currentIndex = 0;

        function showProject(index) {

            slides.forEach(slide => {
                slide.classList.remove("active");
            });

            slides[index].classList.add("active");

            counter.textContent = `${index + 1} / ${slides.length}`;
        }

        nextBtn.addEventListener("click", function () {
            currentIndex = (currentIndex + 1) % slides.length;
            showProject(currentIndex);
        });

        prevBtn.addEventListener("click", function () {
            currentIndex = (currentIndex - 1 + slides.length) % slides.length;
            showProject(currentIndex);
        });

    });
</script>