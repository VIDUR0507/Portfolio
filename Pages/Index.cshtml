@page
@model IndexModel
@{
    ViewData["Title"] = "Vidur Singh | Software Engineer";
}

<section class="hero">
    <div class="wrap hero-grid">
        <div class="hero-copy">
            <p class="eyebrow">Available for work</p>
            <h1>Hi, I'm <span class="accent">Vidur</span></h1>
            <p class="lead">
                I'm a
                <strong>Software Engineer @* &amp; .NET Developer. *@ </strong>
                <br />
                @SiteData.HeroLead
            </p>
            <div class="actions">
                <a class="pill pill-white" href="/#project">View my work
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </a>
                <a class="pill pill-outline" href="/#contact">Get in touch</a>
            </div>
            <dl class="stats">
                @foreach (var s in SiteData.Stats)
                {
                    <div>
                        <dt>@s.Value</dt>
                        <dd>@s.Label</dd>
                    </div>
                }
            </dl>
        </div>
        <div class="portrait">
            @* <img src="@SiteData.ProfileImage" alt="Portrait of @SiteData.Name" width="380" height="380" /> *@
            <img src="~/images/Professional.png" alt="Portrait of @SiteData.Name" width="380" height="580" />
            <span class="badge">Open to projects</span>
        </div>
    </div>
</section>



<section id="about" class="section">
    <div class="wrap">
        <p class="eyebrow">About</p>
        <h2>Software Engineer</h2>
        <p class="muted about-text">@SiteData.About</p>

        <div class="about-content">

            <!-- Top row: Experience and Skills -->
            <div class="about-top-grid">

                <div class="about-block">
                    <h3 class="sub eyebrow">Experience</h3>

                    <ol class="timeline">
                        @foreach (var j in SiteData.Jobs)
                        {
                            <li>
                                <p class="when">@j.Period</p>
                                <h4>@j.Role, @j.Company</h4>

                                <ul class="points">
                                    @foreach (var pt in j.Points)
                                    {
                                        <li>@pt</li>
                                    }
                                </ul>
                            </li>
                        }
                    </ol>
                </div>

                <div class="about-block">
                    <h3 class="sub eyebrow">Skills</h3>

                    <dl class="skills">
                        @foreach (var g in SiteData.Skills)
                        {
                            <div>
                                <dt>@g.Name</dt>
                                <dd>@string.Join(", ", g.Items)</dd>
                            </div>
                        }
                    </dl>
                </div>

            </div>

            <!-- Bottom: Education & Certifications-->
            <div class="about-top-grid">
            <div class="about-block">
                <h3 class="sub eyebrow">Education</h3>

                @foreach (var e in SiteData.Education)
                {
                    <div class="edu">
                        <h4>@e.Degree</h4>
                        <p class="muted">
                            @e.School, @e.Period, @e.Score
                        </p>
                    </div>
                }
            </div>
            <div class="about-block">
                <h3 class="sub eyebrow">Certifications</h3>

                <ul class="points">
                    @foreach (var c in SiteData.Certifications)
                    {
                        <li>@c</li>
                    }
                </ul>
            </div>
            </div>
        </div>
    </div>
</section>


