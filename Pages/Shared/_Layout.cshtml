<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Portfolio of Vidur Singh, a .NET software engineer in Lucknow offering website development, database work, custom software and test automation." />
    <title>@ViewData["Title"]</title>
    <script>try { document.documentElement.dataset.theme = localStorage.getItem('theme') || 'dark'; } catch (e) { }</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fira+Sans:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="wrap bar">
            <a class="brand" href="/"><span>VIDUR SINGH</span></a>
            <nav id="nav" class="nav" aria-label="Main">
                <a href="/#about">About</a>
                <a href="/#project">Project</a>
                <a href="/#services">Services</a>
                <a href="/#contact">Contact</a>
            </nav>
            <div class="tools">
                <button class="icon-btn" id="theme-btn" type="button" aria-label="Switch between dark and light theme">
                    <svg class="i-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    <svg class="i-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                </button>
                <a class="pill pill-orange hire" href="/#contact">Hire me <span aria-hidden="true">&rarr;</span></a>
                <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="nav" aria-label="Open menu">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                </button>
            </div>
        </div>
    </header>

    <main>@RenderBody()</main>

    <footer class="site-footer">
        <div class="wrap">
            <p>&copy; @DateTime.Now.Year @SiteData.Name. Built with ASP.NET Core 9.</p>
            <p><a href="@SiteData.LinkedIn" rel="noopener" target="_blank">LinkedIn</a> &middot; <a href="mailto:@SiteData.Email">Email</a></p>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
